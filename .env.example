SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_IMAGES_BUCKET=question-images
SUPABASE_AUDIOS_BUCKET=question-audios

# Explicitly allow internal users. Empty = deny all users.
ADMIN_EMAILS=["admin@example.com"]
CORS_ORIGINS=["http://localhost:3000"]

OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=
OPENROUTER_AUDIO_MODEL=
OPENROUTER_AUDIO_VOICE=
# chat: streamed /chat/completions audio output; speech: /audio/speech
OPENROUTER_AUDIO_API=chat
# Only enable if the selected speech model supports the instructions parameter.
OPENROUTER_SPEECH_INSTRUCTIONS=false

IMG_GEN_API_KEY=
IMG_GEN_BASE_URL=https://genimg.tguru.vn:8000
IMAGE_POLL_SECONDS=3
IMAGE_TIMEOUT_SECONDS=600
MAX_MEDIA_BYTES=20971520
MAX_ACTIVE_JOBS_PER_USER=3
WORKER_POLL_SECONDS=3
WORKER_LEASE_SECONDS=180
